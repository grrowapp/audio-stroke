{
  "name": "realtime-branch-mvp",
  "private": true,
  "engines": {
    "node": ">=22.13 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 8000",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:realapi": "RUN_REAL_API=1 vitest run tests/realapi",
    "eval:realtime": "node --import tsx server/scripts/evalRealtime.ts",
    "eval:stt": "node --import tsx server/scripts/evalStt.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "nuxt": "4.6.2",
    "openai": "7.43.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@google-cloud/speech": "^8.2.1",
    "@types/ws": "8.18.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.2.5"
  }
}
