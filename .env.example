# Copy to .env and fill in. Keys stay on the server only (never in the browser, logs or Git).
# .env is read by the Nitro server at startup (existing environment variables take precedence).

# ---- providers: mock (no key, no network, labelled MOCK in the UI) or real ----
SCENARIO_PROVIDER=mock        # mock | claude
TTS_PROVIDER=mock             # mock | openai
REALTIME_PROVIDER=mock        # mock | openai

# ---- Anthropic Claude API: scenario generation BEFORE the conversation only ----
ANTHROPIC_API_KEY=
# 設定必須（未設定ならエラー）。利用可能なモデルIDを指定。例: claude-opus-5-5
# ※ この環境からは実APIでのモデル存在確認をしていません。
CLAUDE_SCENARIO_MODEL=
CLAUDE_EFFORT=                # optional: low|medium|high|xhigh|max
CLAUDE_OUTPUT_MODE=structured # structured (output_config.format json_schema) | tool (strict tool)
CLAUDE_REFUSAL_FALLBACK=off   # off | default (server-side refusal fallback beta)
CLAUDE_TIMEOUT_S=180
CLAUDE_MAX_ATTEMPTS=3

# ---- OpenAI: TTS (pre-generation) and Realtime (classification during the conversation) ----
OPENAI_API_KEY=
# 設定必須。openai SDK 7.43 の型定義に載っている候補: gpt-4o-mini-tts / tts-1 / tts-1-hd
TTS_MODEL=
# 設定必須。候補: marin / cedar / alloy / coral / sage ...（日本語の聞こえ方は要試聴）
TTS_VOICE=
TTS_FORMAT=mp3                # mp3 | wav
TTS_ALLOWED_MODELS=           # comma-separated extra choices shown in the UI
TTS_ALLOWED_VOICES=
TTS_CONCURRENCY=2
# 設定必須。候補: gpt-realtime-2.1 / gpt-realtime / gpt-realtime-mini ...（実APIで要確認。元MVPの既定は gpt-realtime-2.1）
REALTIME_MODEL=
REALTIME_URL=wss://api.openai.com/v1/realtime
PREVIEW_AUDIO_MODE=inline     # inline (out-of-band inline input_audio) | item (item.create + ack + item_reference)

HOST=127.0.0.1
PORT=8000
DATA_DIR=
MAX_CONCURRENT_SESSIONS=1     # 同時に実行できる会話セッション数（費用・負荷の上限）
EXTRA_ALLOWED_HOSTS=          # comma-separated extra Host header values (dev only)

# ---- hosted verification (e.g. Render; see render.yaml) ----
# PUBLIC_HOSTNAME=app.example.com   # public Host to accept (RENDER_EXTERNAL_HOSTNAME is picked up automatically)
# Basic auth gate: enabled only when BOTH are set. Required before exposing the app (it calls paid APIs).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ---- Japanese reading lexicon (読み替え辞書 / 誤読ルール) ----
# Bundled: server/lexicon/ja.json. Optional extra file in the same format, merged over it (later wins by surface).
LEXICON_PATH=

# ---- Comparative STT + Clef evaluation (npm run eval:stt, paid, optional) ----
# Cloudflare Workers AI (Clef decision model): account id + API token with Workers AI Read/Edit
CF_ACCOUNT_ID=
CF_API_TOKEN=
DEEPGRAM_API_KEY=
REVAI_ACCESS_TOKEN=
# Google Speech-to-Text v2: service-account JSON path + project id (chirp_3 streaming is served from "us" / "eu")
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PROJECT_ID=
# GOOGLE_STT_LOCATION=us
# GOOGLE_STT_MODEL=chirp_3
# TypeSafe Jev decision model (alternative judge to Clef)
TYPESAFE_API_KEY=

# ---- Decision backend (docs/DECISION_BACKEND.md): what listens and decides during the call ----
# realtime (OpenAI Realtime: VAD + audio classification) | stt_judge (streaming STT + decision model) | mock
# Default: realtime when REALTIME_PROVIDER=openai, else mock. This is only the default: the UI's
# runtime setting "判定バックエンド" (runtime.decision_backend) picks per session, no restart needed.
DECISION_BACKEND=
# stt_judge parts
STT_PROVIDER=mock            # revai | deepgram | google | mock
JUDGE_PROVIDER=mock          # clef | jev | openai_compat | mock
JUDGE_MODEL=clef-flash       # clef-flash | clef | jev-latest | <local model name>
JUDGE_UNCLEAR_THRESHOLD=0.5  # judge confidence below this → ctrl_unclear (0 = off)
# JUDGE_URL=http://127.0.0.1:8000/v1   # openai_compat (vLLM / llama.cpp / Ollama) base URL
# JUDGE_API_KEY=
# STT_VAD_RMS=500              # built-in energy VAD threshold (providers without VAD, e.g. revai)
# STT_FINAL_WAIT_MS=1200       # wait for the provider's final transcript after speech end
